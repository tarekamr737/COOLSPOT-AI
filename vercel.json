{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "api.app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "service": "backend", "path": "/health" }
    },
    {
      "source": "/v1/:path*",
      "destination": { "service": "backend", "path": "/v1/:path*" }
    },
    {
      "source": "/",
      "destination": { "service": "web", "path": "/" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "web", "path": "/:path*" }
    }
  ]
}
